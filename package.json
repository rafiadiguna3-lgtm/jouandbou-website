{
  "name": "jou-and-bou-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independently deployable copy of the published Jou and Bou frontend",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run build && http-server dist -p 5173 -a 0.0.0.0 -c-1",
    "build": "node scripts/build.mjs",
    "preview": "http-server dist -p 4173 -a 0.0.0.0 -c-1",
    "test": "node --test tests/assets.test.mjs tests/map-lod.test.mjs tests/brand-routing.test.mjs",
    "test:browser": "playwright test",
    "test:reference": "node scripts/compare-live.mjs",
    "manifest:update": "node scripts/update-manifest.mjs",
    "build:vercel": "node scripts/vercel-build.mjs",
    "test:staging": "playwright test --config playwright.staging.config.mjs",
    "test:deployment-config": "node --test tests/deployment-config.test.mjs",
    "build:map-lod": "node scripts/build-map-lod.mjs",
    "test:devices": "playwright test tests/browser/device-matrix.spec.mjs",
    "build:project-catalog": "node scripts/build-project-catalog.mjs",
    "build:project-previews": "node scripts/build-project-previews.mjs",
    "test:projects": "npm run build && node --test tests/project-pages.test.mjs && playwright test tests/browser/project-seo.spec.mjs",
    "ci:source": "npm run build && node --test tests/*.test.mjs",
    "ci:browser": "playwright test tests/browser/metadata.spec.mjs tests/browser/project-seo.spec.mjs tests/browser/project-tools.spec.mjs tests/browser/project-inquiry.spec.mjs tests/browser/responsive-audit.spec.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "http-server": "14.1.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0"
  }
}
